// Dock_Mode for MacBook
sudo pmset -b sleep 0; sudo pmset -b disablesleep 1

// Grid_Size for Launchpad
defaults write com.apple.dock springboard-rows -int 5
defaults write com.apple.dock springboard-columns -int 6;killall Dock

// Change Screenshot Type
defaults write com.apple.screencapture type JPG

// Quick Hide Dock
defaults write com.apple.dock autohide-time-modifier -int 0;killall Dock

// Reduce Font Smoothing
defaults -currentHost write -g AppleFontSmoothing -int 1

// Use Tab Navigation
defaults write NSGlobalDomain AppleKeyboardUIMode -int "2"

// Three-finger dragging
defaults write com.apple.AppleMultitouchTrackpad "TrackpadThreeFingerDrag" -bool "true"

// Disable Apple Intelligence
defaults write com.apple.CloudSubscriptionFeatures.optIn "545129924" -bool "false"

// Display Desktop Icons
defaults write com.apple.finder "CreateDesktop" -bool "false" && killall Finder

// Show Disks
defaults write com.apple.finder "ShowHardDrivesOnDesktop" -bool "true" && killall Finder

// File Extension Warning
defaults write com.apple.finder "FXEnableExtensionChangeWarning" -bool "false" && killall Finder

// Finder Status Bar
defaults write com.apple.finder "ShowStatusBar" -bool "true" && killall Finder

// Folder on Top
defaults write com.apple.finder "_FXSortFoldersFirst" -bool "true" && killall Finder

// Show Path Finder
defaults write com.apple.finder "ShowPathbar" -bool "true" && killall Finder

// Show File Extensions
defaults write NSGlobalDomain "AppleShowAllExtensions" -bool "true" && killall Finder

// Dock Icon Size
defaults write com.apple.dock "tilesize" -int "42" && killall Dock

// Disable Screenshot Shadow
defaults write com.apple.screencapture "disable-shadow" -bool "true"

// Show Recent Apps Dock
defaults write com.apple.dock "show-recents" -bool "false" && killall Dock

// Focus Follow Mouse
defaults write com.apple.Terminal "FocusFollowsMouse" -bool "true" && killall Terminal
