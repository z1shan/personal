# Font
font-family = JetBrainsMono Nerd Font Mono
font-size = 13.5
font-thicken = 1

# Window
window-decoration = true
background-opacity = 0.75
background-blur-radius = 25

# Padding
window-padding-x = 18
window-padding-y = 16
window-padding-balance = true

# Initial window size — 110 columns × 45 rows
window-width = 85
window-height = 32

# Theme
theme = Purplepeter
macos-icon = glass

#close-behaviour
confirm-close-surface = false

#shell
shell-integration-features = ssh-terminfo



